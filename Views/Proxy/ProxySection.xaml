<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FluentScrobbler.Views.Proxy.ProxySection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ic="using:FluentIcons.WinUI"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <StackPanel Spacing="4" Margin="0,0,0,4">
            <TextBlock Text="Proxy" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
            <TextBlock Text="Route Last.fm traffic through a built-in SOCKS5 proxy for countries where Last.fm is blocked." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ic:SymbolIcon Grid.Column="0" Symbol="CloudSync" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,16,0" />

                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Proxy Mode" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ComboBox x:Name="ModeComboBox" MinWidth="240" MaxWidth="360" HorizontalAlignment="Left" SelectionChanged="ModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Disabled" Tag="Disabled" />
                        <ComboBoxItem Content="Manual" Tag="Manual" />
                        <ComboBoxItem Content="Auto" Tag="Auto" />
                    </ComboBox>
                    <TextBlock x:Name="ModeDescriptionText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ManualCard" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="8">
                <TextBlock Text="Manual Proxy" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="ManualHostTextBox" PlaceholderText="Host / IP" MinWidth="200" VerticalAlignment="Center" />
                    <TextBox x:Name="ManualPortTextBox" PlaceholderText="Port" Width="90" InputScope="Number" VerticalAlignment="Center" />
                    <Button x:Name="ManualApplyButton" Content="Apply" Click="ManualApplyButton_Click" VerticalAlignment="Center" />
                    <Button x:Name="ManualPingButton" Content="Ping" Click="ManualPingButton_Click" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="ManualStatusText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border x:Name="AutoCard" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel Spacing="8">
                <TextBlock Text="Proxy List" Style="{ThemeResource BodyStrongTextBlockStyle}" />

                <ListBox x:Name="ProxyListListBox" MaxHeight="220" SelectionChanged="ProxyListListBox_SelectionChanged" HorizontalAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RefreshListButton" Content="Refresh" Click="RefreshListButton_Click" />
                    <TextBlock x:Name="ProxyListStatusText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Host" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="AutoHostTextBox" IsReadOnly="True" Width="220" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Port" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="AutoPortTextBox" IsReadOnly="True" Width="90" />
                    </StackPanel>
                    <Button x:Name="AutoPingButton" Content="Ping" Click="AutoPingButton_Click" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                </StackPanel>

                <TextBlock x:Name="AutoStatusText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
